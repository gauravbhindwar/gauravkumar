# Database (Supabase Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=portfolio

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# Resend (sends the public contact form server-side - api.resend.com)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>

# Admin Configuration (used by scripts/create-admin.js and scripts/seed-admin.js)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# GitHub activity banner/section (public data, no auth needed)
# GITHUB_USERNAME defaults to gauravbhindwar in code if unset.
# GITHUB_TOKEN is optional - raises the API rate limit from 60/hr to 5,000/hr;
# a classic PAT with no scopes (public data only) is enough.
GITHUB_USERNAME=gauravbhindwar
GITHUB_TOKEN=
